# Database configuration
# In Docker, use: postgresql+psycopg://factmesh:factmesh@postgres:5432/factmesh
# For local SQLite fallback, leave blank or set: sqlite:///./factmesh.db
DATABASE_URL=sqlite:///./factmesh.db

# Redis queue configuration (optional in local development, uses built-in BackgroundTasks worker)
REDIS_URL=redis://localhost:6379/0

# Storage configuration
STORAGE_DIR=./data/storage

# LLM Provider configuration ('gemini', 'openai', or 'offline_heuristic')
# 'offline_heuristic' is the built-in deterministic provider that requires NO external API keys and runs 100% offline!
LLM_PROVIDER=offline_heuristic

# API Keys (optional if using offline_heuristic)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Security
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
